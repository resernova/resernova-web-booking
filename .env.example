# ReserNova Web Booking — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env*local*.
#
# # === A. Next.js app (this file) ===
#
# Supabase project (read by lib/supabase/* and app/sitemap.ts)
NEXT_PUBLIC_SUPABASE_URL=https://mispcthlkuygvaoexovk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1pc3BjdGhsa3V5Z3Zhb2V4b3ZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTU5MDE1NDEsImV4cCI6MjA3MTQ3NzU0MX0.7QLjB-UZthSsjJ5tBSx2ryKHM9srlTYuefYyrzgH0pY

# Supabase service role — bypasses RLS for trusted server-only code paths.
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1pc3BjdGhsa3V5Z3Zhb2V4b3ZrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NTkwMTU0MSwiZXhwIjoyMDcxNDc3NTQxfQ.nGguxhJ39f_9bure3Ju0EjffX7K0MWO3qgmAKpoNXBw

# Absolute base URL used for OG metadata, sitemap, and link generation
NEXT_PUBLIC_SITE_URL=https://book.resernova.com

# Sentry (optional — both forms accepted; NEXT_PUBLIC_DSN is browser-side)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# # === B. Supabase Vault (run via `npx supabase secrets set`, NOT here) ===
#
# Once set, these are stored as vault.decrypted_secrets rows and read by RPCs.
#
# npx supabase secrets set WEB_MANAGE_TOKEN_KEY=$(openssl rand -hex 32)
# npx supabase secrets set WEB_BOOKING_SIGNING_SECRET=$(openssl rand -hex 32)
#
# Edge Function secrets (same command):
# npx supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# npx supabase secrets set RESEND_FROM_EMAIL="ReserNova <bookings@resernova.com>"
# npx supabase secrets set WEB_BOOKING_SIGNING_SECRET=<same-as-above>
# npx supabase secrets set WHATSAPP_ENABLED=false
#
# Phase 2 (after Meta template approved):
# npx supabase secrets set WHATSAPP_ENABLED=true
# npx supabase secrets set META_APP_ID=...
# npx supabase secrets set META_ACCESS_TOKEN=...
# npx supabase secrets set META_PHONE_NUMBER_ID=...
# npx supabase secrets set WHATSAPP_VERIFY_TOKEN=...
#
# # === C. Vercel project env vars ===
#
# Set each one via Vercel dashboard or `vercel env add`:
#   vercel env add NEXT_PUBLIC_SUPABASE_URL production
#   vercel env add NEXT_PUBLIC_SUPABASE_ANON_KEY production
#   vercel env add SUPABASE_SERVICE_ROLE_KEY production
#   vercel env add NEXT_PUBLIC_SITE_URL production
#   vercel env add SENTRY_DSN production
