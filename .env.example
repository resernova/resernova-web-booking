# ReserNova Web Booking — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env*local*.

# Supabase (existing project — read-only from web BFF; service-role key stays server-side only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC manage token key (32 random bytes, hex) — mirrored into Vault as web_manage_token_key
# Generate: openssl rand -hex 32
WEB_MANAGE_TOKEN_KEY=

# Shared secret between create_web_booking RPC and web-booking-notify Edge Function
# Generate: openssl rand -hex 32 — set same value in `supabase secrets set`
WEB_BOOKING_SIGNING_SECRET=

# Resend (transactional email) — Phase 1 day-1
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@resernova.com

# Meta WhatsApp (used by Edge Function only — never expose to client)
META_APP_ID=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Google OAuth (optional — for analytics integration)
GOOGLE_WEB_CLIENT_ID=

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel Analytics (auto-populated by Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Site URL (used for absolute URLs in emails, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://book.resernova.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr